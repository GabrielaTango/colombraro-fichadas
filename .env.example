# Copiar a .env y completar con valores reales.
# Usado por docker-compose.yml (stack SQL Server + Backend + Frontend).

# Password del usuario 'sa' de SQL Server.
# SQL Server exige: 8+ caracteres, con mayúsculas, minúsculas, números y símbolos.
SA_PASSWORD=CambiarEstePassword123!

# Clave de firma de los JWT. Mínimo 32 caracteres.
# Generar una nueva por entorno, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=CAMBIAR_ESTA_CLAVE_SECRETA_EN_PRODUCCION_MINIMO_32_CARACTERES

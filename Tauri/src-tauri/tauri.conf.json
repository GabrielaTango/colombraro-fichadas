{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colombraro Fichadas",
  "version": "0.1.0",
  "identifier": "com.colombraro.fichadas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Fichadas Colombraro",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "category": "Business",
    "shortDescription": "Sistema de Fichadas y Licencias Colombraro",
    "longDescription": "Sistema de administración de control de personal (fichadas, licencias, novedades) para Colombraro."
  },
  "plugins": {}
}
